{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Calchy",
  "mainBinaryName": "calchy",
  "version": "1.3.0",
  "identifier": "io.github.calchy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Calchy",
        "width": 420,
        "height": 560,
        "minWidth": 280,
        "minHeight": 200,
        "center": true,
        "decorations": false,
        "visible": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm"],
    "category": "Utility",
    "shortDescription": "Calcolatrice testuale",
    "longDescription": "Calchy è un blocco note infinito che fa i calcoli: scrivi testo e operazioni, i risultati compaiono a destra.",
    "copyright": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3"],
        "desktopTemplate": "calchy.desktop",
        "release": "1"
      }
    }
  }
}
